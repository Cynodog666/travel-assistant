# ---------------------------------------------------------------------------
# 复制本文件为 .env，然后填入真实值。
# .env 已被 .gitignore 排除，不会被提交到仓库。
# ---------------------------------------------------------------------------

# 运行环境：production 时会强制要求设置 ACCESS_TOKEN
NODE_ENV=development

# 服务端口
PORT=3000

# --- 大模型接口（任意兼容 OpenAI Chat Completions 协议的服务都行）---
# 例如：https://api.openai.com/v1/chat/completions
#       https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#       https://api.deepseek.com/v1/chat/completions
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-在这里填入你的key
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
# 单次模型调用超时（毫秒）
AI_TIMEOUT_MS=60000

# --- 高德地图开放平台 ---
# 申请地址：https://console.amap.com/dev/key/app （选「Web服务」类型）
AMAP_KEY=在这里填入你的高德key
# 高德接口域名，一般不用改；要走代理时填代理的地址
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_MS=8000

# --- 和风天气（可选，配了就用它替换高德那个「只有实时值」的天气工具）---
# 控制台：https://console.qweather.com/project
# 两个值都在控制台里看：
#   QWEATHER_API_KEY  ← 项目 → 凭据 → 添加凭据 → 身份认证方式选 API KEY
#   QWEATHER_BASE_URL ← 设置（https://console.qweather.com/setting）里的 API Host，前面补 https://
# 注意：API Host 是每个账号随机分配的，形如 https://abc123.xx.qweatherapi.com
#   —— 不要照抄文档里举例的地址（那是示例，解析不出来的）。
# 两个都填或者都留空；只填一个会启动失败。
QWEATHER_API_KEY=
QWEATHER_BASE_URL=
QWEATHER_TIMEOUT_MS=8000

# --- 访问控制（部署到公网必填）---
# 生成一个：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 留空 = 不鉴权，只适合本机自用；NODE_ENV=production 时留空会直接启动失败。
ACCESS_TOKEN=

# 反向代理（Nginx / Railway / Render）后面要设成 true，
# 否则限流会按代理的 IP 计数，所有人共用一个额度。
TRUST_PROXY=false

# --- 限流：每个 IP 每个窗口最多发多少条 ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# --- 会话与工具调用 ---
MAX_TOOL_STEPS=5
MAX_HISTORY_TURNS=20
MAX_SESSIONS=500
# 会话闲置多久后清理（毫秒），默认 2 小时
SESSION_TTL_MS=7200000
AMAP_CACHE_SIZE=200
